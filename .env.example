# Copy this file's variable names into your Vercel project's Environment
# Variables (Project Settings -> Environment Variables). Do not commit a real
# .env file with actual values — .env/.env.local are already git-ignored.

# Required. API key from https://resend.com (Settings -> API Keys).
RESEND_API_KEY=

# Optional. Only set this once a sending domain is verified with Resend
# (e.g. urgentcleankamloops.ca). Until then, api/quote.js falls back to
# Resend's shared "onboarding@resend.dev" sender, which needs no verification.
# RESEND_FROM="Urgent Clean <quotes@urgentcleankamloops.ca>"
