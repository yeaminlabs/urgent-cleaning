# Copy this file's variable names into your Vercel project's Environment
# Variables (Project Settings -> Environment Variables). Do not commit a real
# .env file with actual values — .env/.env.local are already git-ignored.

# Gmail SMTP for the quote form (api/quote.js), sent via Nodemailer.

# Required. The Gmail address quote requests are sent from and delivered to.
# SMTP_USER should be urgentcleankamloops@gmail.com
SMTP_USER=

# Required. SMTP_PASS should be a Google App Password, not the normal Gmail
# account password. Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account).
SMTP_PASS=

# Set real values in Vercel Environment Variables. Never commit real
# credentials to this file or anywhere else in the repo.
